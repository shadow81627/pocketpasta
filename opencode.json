{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CODING_STANDARDS.md"],
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "watcher": {
    "ignore": [
      "**/dist/**",
      "**/.nuxt/**",
      "**/.output/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/yarn.lock",
      "**/package-lock.json"
    ]
  }
}
